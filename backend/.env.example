# ============================================================
# AI Data Enrichment Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="AI Data Enrichment Platform"
APP_ENV=development          # development | production
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# ── Database ─────────────────────────────────────────────────
# SQLite (default, zero config)
DATABASE_URL=sqlite+aiosqlite:///./data/enrichment.db

# PostgreSQL (uncomment to use)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enrichment_db

# MySQL (uncomment to use)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/enrichment_db

# ── AI Providers ─────────────────────────────────────────────
# Default provider: gemini | openai | anthropic
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-pro

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Search APIs ──────────────────────────────────────────────
# Google Custom Search (for web search source)
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY_HERE
GOOGLE_SEARCH_ENGINE_ID=YOUR_SEARCH_ENGINE_ID_HERE

# ── Worker Engine ─────────────────────────────────────────────
DEFAULT_CONCURRENCY=5
DEFAULT_RETRIES=3
DEFAULT_TIMEOUT_SECONDS=30
WORKER_POLL_INTERVAL=1.0

# ── Encryption ───────────────────────────────────────────────
# Must be 32 bytes base64-encoded key for Fernet
ENCRYPTION_KEY=CHANGE_ME_RUN_python_-c_"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"

# ── Notifications (all optional) ─────────────────────────────
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
SMTP_FROM=your@email.com
NOTIFY_EMAIL=recipient@email.com

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Discord
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE

# Slack
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN_HERE
SLACK_CHANNEL=#enrichment-alerts

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_ENABLED=true
WATCH_FOLDER=./uploads
SCHEDULER_TIMEZONE=UTC

# ── Browser Module (optional) ─────────────────────────────────
BROWSER_MODE_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_SCREENSHOTS_DIR=./screenshots

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/platform.log
